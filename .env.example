# ==================== ЛОКАЛЬНОЕ ХРАНИЛИЩЕ ====================
# Цель — PostgreSQL. Пример:
#   DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/granit_rests
# Fallback (работает без сервера) — SQLite:
DATABASE_URL=sqlite:///data/granit_rests.sqlite3

# ==================== ИСТОЧНИК: ЛОКАЛЬНАЯ КОПИЯ .GDB ====================
# Путь к копии боевой БД (Firebird 2.5, ODS 11)
GDB_PATH=data/input/db/GEORGIA.GDB
# Каталог с Firebird 2.5 embedded (содержит fbembed.dll, firebird.msg, intl/)
FB_CLIENT_DIR=tools/fb25
GDB_USER=SYSDBA
GDB_PASSWORD=masterkey
# ID предприятия для отчёта остатков (MoveGoodsAll); если пусто — из STORLIST
OURORGNID=12978
# USERID для фильтра UserGGrp в отчёте Granit
STOCK_REPORT_USER_ID=1

# ==================== ИНКРЕМЕНТ: PROXY API (опционально) ====================
PROXY_API_URL=
PROXY_API_TOKEN=
PROXY_API_TIMEOUT=90

# ==================== ПАРАМЕТРЫ АНАЛИЗА ====================
# Уровень сервиса для расчётного страхового запаса (доля, напр. 0.95)
SERVICE_LEVEL=0.95
# Срок поставки по умолчанию, недель (настраивается; учёт границы/таможни)
DEFAULT_LEAD_TIME_WEEKS=8
# Окно сезонного сравнения, +/- недель вокруг текущей
SEASON_WINDOW_WEEKS=3
